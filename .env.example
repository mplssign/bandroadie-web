# =============================================================================
# BandRoadie — Environment Variables
#
# Copy this file to .env and fill in your credentials.
# .env is GITIGNORED and must NEVER be committed.
#
# All values are injected at compile time via --dart-define.
# The build scripts (tools/deploy_web.sh, tools/build_ios.sh, tools/build_android.sh)
# source this file automatically.
# =============================================================================

# ── Supabase ──────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# ── Firebase (Web push notifications) ────────────────────────
FIREBASE_API_KEY=your-firebase-api-key
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=000000000000
FIREBASE_APP_ID=1:000000000000:web:your-app-id
FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

